# Application Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Authoritative Relational Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/tactiron_outbound?schema=public"

# Emergency Controls & Review Policy
KILL_SWITCH_ACTIVE=false
REVIEW_MODE=STRICT_MONTH_1 # STRICT_MONTH_1 (100% review) | STANDARD_SAMPLE (10-20% review)
POLICY_MIN_TEAM_SIZE=20

# Smartlead Integration
SMARTLEAD_API_KEY=
SMARTLEAD_WEBHOOK_SECRET=

# Apollo Enrichment
APOLLO_API_KEY=

# LLM Inference (Anthropic Claude)
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# Odoo CRM Integration
ODOO_URL=https://crm.tactiron.com
ODOO_DB=crm.tactiron.com
ODOO_USERNAME=technical@tactiron.com
ODOO_API_KEY=
# Where warm handovers land, by name (same values on test and live). Unset team = Odoo's default pipeline.
ODOO_TEAM_NAME=
ODOO_STAGE_NAME=

# Operational Alerts & Notifications
SLACK_WEBHOOK_URL=
COMPLIANCE_OFFICER_EMAIL=compliance@tactiron.com
SALES_ESCALATION_EMAIL=sales-escalations@tactiron.com
